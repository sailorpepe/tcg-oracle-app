{
  "expo": {
    "name": "TCG Oracle",
    "slug": "tcg-oracle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tcgoracle",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theundesirables.tcgoracle",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow TCG Oracle to access your camera to scan and grade trading cards"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "oracleApiUrl": "https://oracle.the-undesirables.com"
    }
  }
}
